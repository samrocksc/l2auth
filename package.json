{
  "name": "l2auth",
  "version": "1.0.0",
  "private": true,
  "description": "A beginner-friendly guide to authentication and Customer Identity and Access Management (CIAM).",
  "type": "module",
  "scripts": {
    "serve": "python3 -m http.server 8080",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check .",
    "check:html": "html-validate \"**/*.html\"",
    "check:links": "node scripts/check-links.mjs",
    "check:all": "npm run check && npm run check:html && npm run check:links",
    "diagrams": "node scripts/render-diagrams.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "excalirender": "0.1.5",
    "html-validate": "11.21.0"
  }
}
